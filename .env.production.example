# InfiniTG - Laravel Production Environment Example
# Copy these values into Railway Variables (do NOT commit real secrets).

APP_NAME=InfiniTG
APP_ENV=production
APP_KEY=base64:GENERATE_WITH_PHP_ARTISAN_KEY_GENERATE
APP_DEBUG=false
APP_URL=https://your-app.up.railway.app

LOG_CHANNEL=daily
LOG_LEVEL=warning

# Railway MySQL service values (use Railway service reference variables or real values)
DB_CONNECTION=mysql
DB_HOST=your-railway-mysql-host
DB_PORT=3306
DB_DATABASE=railway
DB_USERNAME=root
DB_PASSWORD=your_db_password_here

SESSION_DRIVER=file
QUEUE_CONNECTION=sync

# Telegram - replace with your real values in Railway Variables only
TELEGRAM_API_ID=your_telegram_api_id
TELEGRAM_API_HASH=your_telegram_api_hash

STORAGE_DRIVER=telegram

INFINITG_MAX_STORAGE_MB=2048
INFINITG_MAX_UPLOAD_KB=51200
